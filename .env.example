# Server Configuration
PORT=3000
NODE_ENV=development

# Authentication
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
API_KEY=

# Database URLs
DATABASE_URL=
DATABASE_URL_DEV=
DATABASE_URL_LOCAL=postgresql://postgres:root@localhost:5432/fplapi
DATABASE_URL_PROD=

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15 minutes

# CORS Configuration
CORS_ORIGIN=*

# Feature Toggles
ENABLE_GRAPHIQL=true
ENABLE_SWAGGER=true

# Logging
LOG_LEVEL=info


